diff --git a/src/seenstore.py b/src/seenstore.py
new file mode 100644
index 0000000..1bd4a58
--- /dev/null
+++ b/src/seenstore.py
@@ -0,0 +1,219 @@
+"""Shared, persistent memory of candidate scores.
+
+The permuter's own cache (_score_for_source) lives in one worker process and dies with the run. Measured on
+two 60 s x 8-worker runs: 20-36% of compiles repeated a candidate another worker had compiled, and on a second
+run of the same function 35-52% of compiles repeated something already tried. This store is shared by all
+workers (one append-only file per process, read by the others every few seconds) and kept between runs.
+
+Key = everything a candidate's score depends on besides its own source text: target.o, the compile commands,
+the scorer options and the scorer code. Candidate sources are whole files, so the surrounding code is part of
+the source hash already.
+
+Only scores WORSE than the base are ever served from the store: should_output() never outputs those, so
+results/outputs are unchanged; anything as good as the base or better is compiled and scored as before.
+Disable with PERM_SEEN=0. Root: PERM_SEEN_DIR, default <run dir>/../_seen. Unused stores are deleted after
+KEEP_DAYS; a store with many worker files merges the finished ones.
+"""
+import glob
+import hashlib
+import json
+import os
+import re
+import time
+from typing import Dict, Optional
+
+REFRESH_SECONDS = 5.0
+MAX_ENTRIES = 2_000_000   # ~200 MB worst case per process; the store stops growing in memory beyond this
+KEY_HEX = 32              # 128 bits of the sha256: no collision in practice, half the disk of the full hash
+MERGE_AT = 48             # more worker files than this in one store: merge the finished ones into one
+KEEP_DAYS = 14            # stores not used for this long are deleted (old keys after a helper-script change)
+
+
+def store_key(run_dir: str, scorer: object) -> str:
+    h = hashlib.sha256(b"seenstore v1")
+    for name in ("target.o", "compile.sh", "compile_native.json"):
+        try:
+            with open(os.path.join(run_dir, name), "rb") as f:
+                data = f.read()
+        except OSError:
+            data = b"-"
+        if name != "target.o":   # lanes of one function differ only in their folder name
+            data = data.replace(os.path.basename(os.path.normpath(run_dir)).encode(), b"<RUN>")
+        h.update(name.encode() + b"\0" + data + b"\0")
+    # our own compile helpers shape the object too (compile_native.json's driver, isolate_function.py in compile.sh)
+    scripts = set()
+    try:
+        with open(os.path.join(run_dir, "compile_native.json"), encoding="utf-8") as f:
+            driver = json.load(f).get("driver")
+        if driver:
+            scripts.update([driver, os.path.join(os.path.dirname(driver), "isolate_function.py")])
+    except (OSError, ValueError, AttributeError):
+        pass
+    try:
+        with open(os.path.join(run_dir, "compile.sh"), encoding="utf-8", errors="replace") as f:
+            scripts.update(re.findall(r'"([^"]+\.py)"', f.read()))
+    except OSError:
+        pass
+    for path in sorted(scripts):
+        try:
+            with open(path, "rb") as f:
+                h.update(path.encode() + b"\0" + f.read())
+        except OSError:
+            pass
+    for attr in ("stack_differences", "algorithm", "ign_branch_targets", "objdump_command"):
+        h.update(("%s=%r\0" % (attr, getattr(scorer, attr, None))).encode())
+    here = os.path.dirname(os.path.abspath(__file__))
+    for name in ("scorer.py", "objdump.py", "compiler.py"):
+        try:
+            with open(os.path.join(here, name), "rb") as f:
+                h.update(f.read())
+        except OSError:
+            pass
+    return h.hexdigest()[:24]
+
+
+class SeenStore:
+    def __init__(self, run_dir: str, fn_name: str, scorer: object) -> None:
+        root = os.environ.get("PERM_SEEN_DIR") or os.path.join(os.path.dirname(os.path.normpath(run_dir)), "_seen")
+        # named after the run folder (lanes: __tfocus/__twhole; the function inside may be renamed, e.g. permX)
+        name = re.sub(r"__(tfocus|twhole|focus|parallel)$", "", os.path.basename(os.path.normpath(run_dir))) or fn_name
+        safe = "".join(c if c.isalnum() or c in "_-" else "_" for c in name)[:60]
+        self.dir = os.path.join(root, "%s_%s" % (safe, store_key(run_dir, scorer)))
+        os.makedirs(self.dir, exist_ok=True)
+        self.own = os.path.join(self.dir, "%d_%d.txt" % (os.getpid(), time.time_ns()))
+        self.scores: Dict[str, int] = {}
+        self.offsets: Dict[str, int] = {}
+        self.next_refresh = 0.0
+        self.hits = self.adds = 0
+        self.refresh()
+        self.merge()
+        self.out = open(self.own, "a", encoding="ascii")
+
+    def merge(self) -> None:
+        """The parallel restarts its workers often (one file each): fold finished files into one. Everything was read
+        by refresh() just before; a file untouched for 2 minutes belongs to a worker that has ended."""
+        files = glob.glob(os.path.join(self.dir, "*.txt"))
+        if len(files) <= MERGE_AT:
+            return
+        lock = os.path.join(self.dir, "merge.lock")
+        try:
+            if time.time() - os.path.getmtime(lock) > 600:
+                os.remove(lock)   # left behind by a killed worker
+        except OSError:
+            pass
+        try:
+            fd = os.open(lock, os.O_CREAT | os.O_EXCL | os.O_WRONLY)
+        except OSError:
+            return   # another worker is merging
+        try:
+            now = time.time()
+            done = [f for f in files if now - os.path.getmtime(f) > 120]
+            if len(done) < 2:
+                return
+            tmp = os.path.join(self.dir, "merged_%d_%d.tmp" % (os.getpid(), int(now)))
+            with open(tmp, "w", encoding="ascii") as out:
+                out.writelines("%s %d\n" % kv for kv in self.scores.items())
+            os.replace(tmp, tmp[:-4] + ".txt")
+            self.offsets[tmp[:-4] + ".txt"] = os.path.getsize(tmp[:-4] + ".txt")   # already in memory
+            for f in done:
+                try:
+                    os.remove(f)
+                except OSError:
+                    pass
+        except OSError:
+            pass
+        finally:
+            os.close(fd)
+            try:
+                os.remove(lock)
+            except OSError:
+                pass
+
+    def refresh(self) -> None:
+        self.next_refresh = time.time() + REFRESH_SECONDS
+        for path in glob.glob(os.path.join(self.dir, "*.txt")):
+            if path == self.own:
+                continue
+            start = self.offsets.get(path, 0)
+            try:
+                with open(path, "rb") as f:
+                    f.seek(start)
+                    data = f.read()
+            except OSError:
+                continue
+            end = data.rfind(b"\n") + 1   # a line still being written is read next time
+            if not end:
+                continue
+            self.offsets[path] = start + end
+            if len(self.scores) >= MAX_ENTRIES:
+                continue
+            for line in data[:end].split(b"\n"):
+                parts = line.split()
+                if len(parts) == 2:
+                    try:
+                        self.scores[parts[0].decode()] = int(parts[1])
+                    except ValueError:
+                        pass
+
+    def get(self, source_hash: bytes) -> Optional[int]:
+        if time.time() >= self.next_refresh:
+            self.refresh()
+        score = self.scores.get(source_hash.hex()[:KEY_HEX])
+        if score is not None:
+            self.hits += 1
+            self._stat()
+        return score
+
+    def _stat(self) -> None:
+        """every 200 events write this worker's hits/adds to stats_<pid>.tsv (overwritten; the run
+        is ended with taskkill, so no end-of-run hook). permseen_stats.py sums them per function."""
+        if (self.hits + self.adds) % 200:
+            return
+        try:
+            with open(os.path.join(self.dir, "stats_%d.tsv" % os.getpid()), "w", encoding="ascii") as f:
+                f.write("%d %d %d\n" % (self.hits, self.adds, int(time.time())))
+        except OSError:
+            pass
+
+    def add(self, source_hash: bytes, score: int) -> None:
+        key = source_hash.hex()[:KEY_HEX]
+        if key in self.scores:
+            return
+        if len(self.scores) < MAX_ENTRIES:
+            self.scores[key] = score
+        self.out.write("%s %d\n" % (key, score))
+        self.out.flush()   # the run is ended with taskkill: never keep lines in a buffer
+        self.adds += 1
+        self._stat()
+
+
+def clean_old(root: str) -> None:
+    """At most once an hour: delete stores nobody has used for KEEP_DAYS."""
+    marker = os.path.join(root, ".last_clean")
+    try:
+        if time.time() - os.path.getmtime(marker) < 3600:
+            return
+    except OSError:
+        pass
+    try:
+        os.makedirs(root, exist_ok=True)
+        open(marker, "w").close()
+        for d in glob.glob(os.path.join(root, "*", "")):
+            files = glob.glob(os.path.join(d, "*"))
+            newest = max([os.path.getmtime(f) for f in files] or [os.path.getmtime(d)])
+            if time.time() - newest > KEEP_DAYS * 86400:
+                for f in files:
+                    os.remove(f)
+                os.rmdir(d)
+    except OSError:
+        pass
+
+
+def open_store(run_dir: str, fn_name: str, scorer: object) -> Optional[SeenStore]:
+    if os.environ.get("PERM_SEEN", "1") == "0":
+        return None
+    try:
+        clean_old(os.environ.get("PERM_SEEN_DIR") or os.path.join(os.path.dirname(os.path.normpath(run_dir)), "_seen"))
+        return SeenStore(run_dir, fn_name, scorer)
+    except OSError:
+        return None   # never let the memory stop a permuter run
